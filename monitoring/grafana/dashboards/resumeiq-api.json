          "sort": "desc"
        }
      },
      "pluginVersion": "12.1.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (route, status) (rate(resumeiq_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "API request rate by route and status",
      "type": "timeseries"
    },
