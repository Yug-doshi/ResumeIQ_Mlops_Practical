          "editorMode": "code",
          "expr": "sum(resumeiq_http_requests_total)",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ],
      "title": "Total API requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
