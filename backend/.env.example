# Copy to .env and adjust. No API keys are needed for the core workflow.
APP_NAME=ResumeIQ
ENVIRONMENT=development
LOG_LEVEL=INFO

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_REQUEST=25
MAX_PDF_PAGES=30

# Semantic model (downloaded once from Hugging Face, then cached locally)
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
PRELOAD_MODEL=true
# Set true after the first successful download to guarantee fully offline runs
MODEL_LOCAL_FILES_ONLY=false
# MODEL_CACHE_DIR=C:\path\to\model-cache

# Config files (scoring weights and skill dictionary)
SKILLS_CONFIG_PATH=config/skills.json
SCORING_CONFIG_PATH=config/scoring.json
